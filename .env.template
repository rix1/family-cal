# Family Calendar environment. Copy to `.env` (`cp .env.template .env`) and fill in.
# Loaded automatically by every `deno task` (dev, start, seed, prepare-newsletter,
# …) via Deno's --env-file. Values already set in the real environment win over
# these, and `.env` is gitignored — never commit real secrets.
#
# Everything here is OPTIONAL: with nothing set the app runs against a local KV
# file and logs emails to the console instead of sending. Uncomment what you need.

# --- Core -------------------------------------------------------------------
# Public origin used to build emailed magic links and iCal feed URLs. REQUIRED in
# production: without it prepare_newsletter.ts emails an empty-origin review link
# and routes fall back to ctx.url.origin, which is http:// behind the tunnel.
# BASE_URL=https://cal.example.com

# Path to the Deno KV SQLite database. Must match between the app and any CLI
# task (seed, issue-link, …) or they read different databases. Defaults to
# ./.data/kv.sqlite3 when unset; set it absolute in production so it works from
# any cwd.
# KV_PATH=/Users/rix1/Development/family-cal/.data/kv.sqlite3

# Local dev only: allow non-Secure cookies so magic-link login works over http.
# The `dev` task already sets this; never set it in production (HTTPS/tunnel).
# DEV_INSECURE_COOKIES=1

# --- Email (Resend) ---------------------------------------------------------
# When both are set, mail sends through Resend; otherwise it logs to the console.
# From must use the domain verified in Resend — updates.example.com (see docs/setup.md §5).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=Familiekalender <noreply@updates.example.com>
# RESEND_BASE_URL=https://api.resend.com   # default; override only for testing

# --- Newsletter prose model (local) ----------------------------------------
# The intro is written by a LOCAL model. The built-in Ollama writer needs no
# config; these only override the defaults.
# OLLAMA_HOST=http://127.0.0.1:11434       # default
# INTRO_MODEL=normistral-clean             # default; must be the patched local model
# OLLAMA_KEEP_ALIVE=0                       # unload the model after each run (default);
#                                          # e.g. "5m" to keep it warm, "-1" forever
# INTRO_DISABLED=1                         # turn prose off → drafts use the placeholder
# INTRO_CMD=                               # escape hatch: shell out to a different LOCAL
#                                          # command (prompt on stdin). Never point remote.
