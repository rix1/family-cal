{
  "unstable": ["kv"],
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "vite --host 0.0.0.0 --port 8000",
    "build": "vite build",
    "start": "deno serve --allow-net --allow-env --allow-read --allow-write _fresh/server.js",
    "test": "deno test --allow-net --allow-env --allow-read --allow-write",
    "check": "deno check main.ts && deno test --allow-net --allow-env --allow-read --allow-write"
  },
  "imports": {
    "@/": "./",
    "fresh": "jsr:@fresh/core@^2.0.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.0",
    "vite": "npm:vite@^7.0.0",
    "preact": "npm:preact@10.25.4",
    "@preact/signals": "npm:@preact/signals@^2.0.0",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "types": ["vite/client"]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "exclude": ["**/*.md", "_fresh", "node_modules"]
  },
  "lint": {
    "exclude": ["_fresh", "node_modules"]
  }
}
